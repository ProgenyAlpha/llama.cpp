#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : enable
#if USE_SUBGROUP_ADD
#extension GL_KHR_shader_subgroup_arithmetic : enable
#endif

layout(constant_id = 0) const uint S_V = 128;
layout(constant_id = 1) const uint SUBGROUP_SIZE = 32;
layout(constant_id = 2) const uint KDA = 0;

const uint c_factor = S_V / SUBGROUP_SIZE;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint H;
    uint n_tokens;
    uint n_seqs;
    uint s_off;
    uint sq1, sq2, sq3;
    uint sv1, sv2, sv3;
    uint sb1, sb2, sb3;
    uint neq1, rq3;
    float scale;
};

layout(binding = 0) readonly  buffer QBuf     { float data_q[];     };
layout(binding = 1) readonly  buffer KBuf     { float data_k[];     };
layout(binding = 2) readonly  buffer VBuf     { float data_v[];     };
layout(binding = 3) readonly  buffer GBuf     { float data_g[];     };
layout(binding = 4) readonly  buffer BetaBuf  { float data_beta[];  };
layout(binding = 5) readonly  buffer StateBuf { float data_state[]; };
layout(binding = 6)           buffer DstBuf   { float data_dst[];   };

#if !USE_SUBGROUP_ADD
shared float temp[S_V];
#endif

void main() {
    const uint subgroup = gl_SubgroupID;
    const uint lane     = gl_SubgroupInvocationID;
    const uint tid      = subgroup * SUBGROUP_SIZE + lane;

    const uint head_id = gl_WorkGroupID.x;
    const uint seq_id  = gl_WorkGroupID.y;
    const uint col     = gl_WorkGroupID.z * c_factor + subgroup;

    if (col >= S_V) {
        return;
    }

    const uint iq1 = head_id % neq1;
    const uint iq3 = seq_id / rq3;

    const uint state_size = S_V * S_V;
    const uint state_base = (seq_id * H + head_id) * state_size;

    // Each lane owns c_factor rows of the state column, striped by SUBGROUP_SIZE
    float state[c_factor];
    [[unroll]] for (uint j = 0; j < c_factor; j++) {
        const uint row = SUBGROUP_SIZE * j + lane;
        state[j] = data_state[state_base + row * S_V + col];
    }

    uint attn_off = (seq_id * n_tokens * H + head_id) * S_V;

    for (uint t = 0; t < n_tokens; t++) {
        const uint q_off  = iq3 * sq3 + t * sq2 + iq1 * sq1;
        const uint k_off  = q_off;
        const uint v_off  = seq_id * sv3 + t * sv2 + head_id * sv1;
        const uint gb_off = seq_id * sb3 + t * sb2 + head_id * sb1;

        const float v_val    = data_v[v_off + col];
        const float beta_val = data_beta[gb_off];

        if (KDA == 0) {
            const float g_val = exp(data_g[gb_off]);

            // kv_col = dot(state_col, k) — sharded across lanes
            float kv_partial = 0.0;
            [[unroll]] for (uint j = 0; j < c_factor; j++) {
                const uint row = SUBGROUP_SIZE * j + lane;
                kv_partial += state[j] * data_k[k_off + row];
            }
#if USE_SUBGROUP_ADD
            float kv_col = subgroupAdd(kv_partial);
#else
            temp[tid] = kv_partial;
            barrier();
            [[unroll]] for (uint s = SUBGROUP_SIZE / 2; s > 0; s >>= 1) {
                if (lane < s) { temp[tid] += temp[tid + s]; }
                barrier();
            }
            float kv_col = temp[subgroup * SUBGROUP_SIZE];
            barrier();
#endif

            float delta_col = (v_val - g_val * kv_col) * beta_val;

            // Update state, compute attn_col = dot(state_new, q) — sharded
            float attn_partial = 0.0;
            [[unroll]] for (uint j = 0; j < c_factor; j++) {
                const uint row = SUBGROUP_SIZE * j + lane;
                state[j] = g_val * state[j] + data_k[k_off + row] * delta_col;
                attn_partial += state[j] * data_q[q_off + row];
            }
#if USE_SUBGROUP_ADD
            float attn_col = subgroupAdd(attn_partial);
#else
            temp[tid] = attn_partial;
            barrier();
            [[unroll]] for (uint s = SUBGROUP_SIZE / 2; s > 0; s >>= 1) {
                if (lane < s) { temp[tid] += temp[tid + s]; }
                barrier();
            }
            float attn_col = temp[subgroup * SUBGROUP_SIZE];
            barrier();
#endif

            if (lane == 0) {
                data_dst[attn_off + col] = attn_col * scale;
            }
        } else {
            // KDA path: per-element gate
            float kv_partial = 0.0;
            [[unroll]] for (uint j = 0; j < c_factor; j++) {
                const uint row = SUBGROUP_SIZE * j + lane;
                const float g_elem = exp(data_g[gb_off * S_V + row]);
                kv_partial += g_elem * state[j] * data_k[k_off + row];
            }
#if USE_SUBGROUP_ADD
            float kv_col = subgroupAdd(kv_partial);
#else
            temp[tid] = kv_partial;
            barrier();
            [[unroll]] for (uint s = SUBGROUP_SIZE / 2; s > 0; s >>= 1) {
                if (lane < s) { temp[tid] += temp[tid + s]; }
                barrier();
            }
            float kv_col = temp[subgroup * SUBGROUP_SIZE];
            barrier();
#endif

            float delta_col = (v_val - kv_col) * beta_val;

            float attn_partial = 0.0;
            [[unroll]] for (uint j = 0; j < c_factor; j++) {
                const uint row = SUBGROUP_SIZE * j + lane;
                const float g_elem = exp(data_g[gb_off * S_V + row]);
                state[j] = g_elem * state[j] + data_k[k_off + row] * delta_col;
                attn_partial += state[j] * data_q[q_off + row];
            }
#if USE_SUBGROUP_ADD
            float attn_col = subgroupAdd(attn_partial);
#else
            temp[tid] = attn_partial;
            barrier();
            [[unroll]] for (uint s = SUBGROUP_SIZE / 2; s > 0; s >>= 1) {
                if (lane < s) { temp[tid] += temp[tid + s]; }
                barrier();
            }
            float attn_col = temp[subgroup * SUBGROUP_SIZE];
            barrier();
#endif

            if (lane == 0) {
                data_dst[attn_off + col] = attn_col * scale;
            }
        }

        attn_off += S_V * H;
    }

    // Write back state
    [[unroll]] for (uint j = 0; j < c_factor; j++) {
        const uint row = SUBGROUP_SIZE * j + lane;
        data_dst[s_off + state_base + row * S_V + col] = state[j];
    }
}
